{
  "name": "clarke-chronicles",
  "description": "Clarke Chronicles - a 2D Phaser game.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikka23/clarke-chronicles.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pages:dev": "wrangler pages dev -- npm run dev-nolog",
    "pages:deploy": "npm run build-nolog && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply clarke-chronicles-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply clarke-chronicles-leaderboard --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.3.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
